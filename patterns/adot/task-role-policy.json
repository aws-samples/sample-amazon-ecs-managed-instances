{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "PrometheusRemoteWrite",
            "Effect": "Allow",
            "Action": [
                "aps:RemoteWrite"
            ],
            "Resource": "arn:aws:aps:<AWS_REGION>:<AWS_ACCOUNT_ID>:workspace/*"
        },
        {
            "Sid": "S3GetConfig",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject"
            ],
            "Resource": "arn:aws:s3:::<CONFIG_BUCKET_NAME>/*"
        },
        {
            "Sid": "DescribeContainerInstances",
            "Effect": "Allow",
            "Action": [
                "ecs:DescribeContainerInstances"
            ],
            "Resource": "arn:aws:ecs:<AWS_REGION>:<AWS_ACCOUNT_ID>:container-instance/<CLUSTER_NAME>/*"
        }
    ]
}
